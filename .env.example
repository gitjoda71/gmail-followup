# Kopiera till .env och fyll i. .env är gitignored.
# För GH Actions: sätt motsvarande som repo secrets istället.

# Path till service account JSON-nyckel (DWD aktiverad)
GOOGLE_SA_KEY_PATH=/path/to/secrets/service-account.json

# Workspace-användare som SA impersonerar
DELEGATED_USER=user@example.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vem ska få notiser när motpart svarat (komma-separerad lista — alla får
# samma notis i en gemensam To-header)
NOTIFY_TO=notify@example.com,owner@example.com

# Office hours (Europe/Stockholm) — för dry-run/lokal körning används de inte
OFFICE_HOUR_START=9
OFFICE_HOUR_END=17

# Minimum-tid mellan follow-ups
FOLLOWUP_MIN_HOURS=48

# Komma-separerad lista av domäner som ska filtreras bort från reply-all
# (parter som lämnat ärendet, dotterbolag som inte ska få mer mail, etc.).
# Lämna tom om inga ska filtreras.
EXCLUDE_DOMAINS=

# Komma-separerad lista av specifika adresser att filtrera bort
EXCLUDE_ADDRESSES=

# Komma-separerad lista av adresser som alltid läggs till på CC
EXTRA_CC=

# Fri text som vävs in i alla utkast (rensa när det inte längre behövs)
EXTRA_PROMPT=

# Label-prefix (om du vill byta)
LABEL_ACTIVE=auto-follow-up
LABEL_DRAFTED=auto-follow-up-drafted
LABEL_PAUSED=auto-follow-up-paused
LABEL_TEST=auto-follow-up-test
